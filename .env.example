# ── Required ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Local development (SQLite) ────────────────────────────────────
# Leave DATABASE_URL unset and the app reads this file directly.
DB_PATH=data/apparatus.db
EMBED_BACKEND=local

# ── Production (Supabase) ─────────────────────────────────────────
# Setting DATABASE_URL switches the app to Postgres automatically.
# Use the SESSION pooler string, port 5432. Not the direct connection
# (IPv6-only) and not the transaction pooler (port 6543, breaks psycopg).
# DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# EMBED_BACKEND=voyage
# VOYAGE_API_KEY=...
# Voyage is now owned by MongoDB and there are two endpoints. Match the one
# your key came from, or you get a bare 401:
#   key from voyageai.com           -> leave the default
#   key from Atlas (AI Model APIs)  -> uncomment the line below
# VOYAGE_BASE_URL=https://ai.mongodb.com/v1
# VOYAGE_MODEL=voyage-3.5-lite

# ── Shared ────────────────────────────────────────────────────────
MODEL=claude-sonnet-4-6
TRANSLATIONS=BSB,KJV
CACHE_STUDIES=1
PG_POOL_SIZE=3

# ── Deployment guards (see DEPLOY.md) ─────────────────────────────
# Only the model-calling endpoints are limited; reading scripture is free.
RATE_PER_HOUR=20
RATE_PER_DAY=60
GLOBAL_DAILY_CAP=500        # hard ceiling on model calls per day. 0 disables.

# Set to require a code before running studies. Leave blank for public.
# ACCESS_CODE=

# First-boot database fetch (gzipped SQLite). See scripts/prepare_deploy.py
# DB_URL=https://github.com/you/apparatus/releases/download/v1/apparatus-db.sqlite.gz

# ── Accounts ──────────────────────────────────────────────────────
# ACCOUNTS_REQUIRED=1 makes people sign in before running a study.
# Notes and history become per-person; the study cache stays shared so
# ten people reading John 3:16 is still one model call.
ACCOUNTS_REQUIRED=0
SECRET_KEY=change-me-to-something-random
# INVITE_CODE=          # required to register; blank means open signup
# ADMIN_EMAIL=          # this account can see the usage table

# ── Cost tuning ───────────────────────────────────────────────────
# Commentary passages per study. The evidence packet is most of what a
# study costs, and 12 produces a result very hard to tell from 21.
# One passage per tradition is always seated first, so lowering this
# trims depth, never breadth.
MAX_COMMENTARY=12
