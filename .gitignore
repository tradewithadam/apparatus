__pycache__/
*.py[cod]
.env
.venv/
venv/
data/*.db
data/*.db-wal
data/*.db-shm
corpora/*.jsonl
.DS_Store
.vscode/settings.json

# Cloned data sources — large, re-downloadable, and STEPBible-Data is itself a
# git repo, which git would otherwise record as a broken submodule.
STEPBible-Data/
.swordcache/

# Packaged database for deploy (hundreds of MB)
*.gz
*.sqlite

# The icon PNGs in app/static ARE committed — they are small, and generating
# them at deploy time would mean carrying an image library into production
# for nine files that never change.
!app/static/*.png
